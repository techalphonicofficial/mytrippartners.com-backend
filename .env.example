# Copy to .env and fill in. Loaded automatically by `npm start` (Node 22.13+).
NODE_ENV=production
PORT=8080
# First start only: the admin login created when the database has no staff yet. Change the password after login.
ADMIN_EMAIL=admin@trippartner.com
ADMIN_PASSWORD=change-me-strong-password
# Website domains allowed to call the public API (only needed if the website is hosted on a different domain)
SITE_ORIGIN=https://www.trippartner.com,https://trippartner.com
# MySQL / MariaDB connection (the database and tables are created automatically if the user is allowed to)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=trippartner
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=trippartner
# Uploaded payment proofs / partner IDs are stored in DATA_DIR/uploads
DATA_DIR=/var/lib/trippartner
# Photos offered in the content editor (the Next.js website's public/img; default ../client/public/img)
IMAGES_DIR=/var/www/trippartner/client/public/img
# Where `npm run backup` writes backups
BACKUP_DIR=/var/backups/trippartner

# Next.js website (client/): called when content changes so pages refresh immediately
NEXT_URL=http://127.0.0.1:3000
REVALIDATE_SECRET=change-me-long-random-string
