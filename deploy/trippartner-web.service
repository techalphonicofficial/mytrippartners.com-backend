# systemd alternative to PM2 for the website:  sudo cp deploy/trippartner-web.service /etc/systemd/system/ && sudo systemctl enable --now trippartner-web
# Build first: cd /var/www/trippartner/client && npm ci && npm run build   (the API must be running: pages are prerendered from it)
[Unit]
Description=TripPartner website (Next.js)
After=network.target trippartner.service
Wants=trippartner.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/trippartner/client
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
